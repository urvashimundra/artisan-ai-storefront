<%- include('partials/header') %>
    <p class="crumb"><a href="/orders">&larr; Back to orders</a></p>
    <% if (done) { %><p class="notice" role="status"><%= done %></p><% } %>
    <% if (stateError) { %><p class="error-text" role="alert">This order has changed and that action is no longer possible. The page now shows its current state.</p><% } %>
    <header class="card detail-head">
      <div>
        <p class="eyebrow">Order</p>
        <h1><%= order.reference %></h1>
        <p class="meta">Placed <%= order.createdAt %></p>
      </div>
      <p class="detail-status"><span class="status-badge status-<%= order.status %>"><%= order.statusLabel %></span><% if (order.cancelReasonLabel) { %><span class="meta"><%= order.cancelReasonLabel %></span><% } %></p>
    </header>
    <% if (order.status === 'payment_submitted') { %>
    <p class="callout">The customer says they paid. Check your bank account for the amount and the UTR below, then choose Mark paid or Payment not received. Nothing is verified automatically.</p>
    <% } %>
    <div class="detail-layout">
      <div class="detail-main">
        <section class="card" aria-labelledby="customer-heading">
          <h2 id="customer-heading">Customer</h2>
          <dl class="kv">
            <div><dt>Name</dt><dd><%= order.customerName %></dd></div>
            <div><dt>Phone</dt><dd><%= order.phone %></dd></div>
            <% if (order.customerEmail) { %><div><dt>Email</dt><dd><%= order.customerEmail %></dd></div><% } %>
            <div><dt>Language</dt><dd><%= order.language %></dd></div>
            <% if (order.deliveryAddress) { %><div class="kv-wide"><dt>Delivery address</dt><dd class="pre-line"><%= order.deliveryAddress %></dd></div><% } %>
          </dl>
        </section>
        <section class="card" aria-labelledby="items-heading">
          <h2 id="items-heading">Items</h2>
          <div class="table-wrap">
            <table class="data-table items-table">
              <caption class="visually-hidden">Items in this order</caption>
              <thead><tr><th scope="col">Product</th><th scope="col" class="num">Quantity</th><th scope="col" class="num">Unit price</th><th scope="col" class="num">Line total</th></tr></thead>
              <tbody>
                <% order.items.forEach((item) => { %>
                <tr>
                  <th scope="row" class="cell-name" lang="<%= item.titleLang %>"><%= item.title %></th>
                  <td class="num" data-label="Quantity"><%= item.quantity %></td>
                  <td class="num" data-label="Unit price"><%= item.unitPrice %></td>
                  <td class="num" data-label="Line total"><%= item.lineTotal %></td>
                </tr>
                <% }) %>
              </tbody>
              <tfoot><tr><th scope="row" colspan="3">Total</th><td class="num order-total"><%= order.total %></td></tr></tfoot>
            </table>
          </div>
        </section>
        <section class="card" aria-labelledby="payment-heading">
          <h2 id="payment-heading">Payment</h2>
          <dl class="kv">
            <div><dt>Total payable</dt><dd class="order-total"><%= order.total %></dd></div>
            <div><dt>Payment status</dt><dd><span class="status-badge status-<%= order.status %>"><%= order.statusLabel %></span></dd></div>
            <div><dt>UTR / reference</dt><dd><%= order.utr || 'None yet' %></dd></div>
            <% if (order.submittedAt) { %><div><dt>Payment submitted</dt><dd><%= order.submittedAt %></dd></div><% } %>
            <% if (order.paidAt) { %><div><dt>Marked paid</dt><dd><%= order.paidAt %></dd></div><% } %>
            <% if (order.expiresAt) { %><div><dt>Pay-by time</dt><dd><%= order.expiresAt %></dd></div><% } %>
            <div><dt>Payee UPI ID (when ordered)</dt><dd><%= order.payeeVpa %></dd></div>
            <div><dt>UTR submissions</dt><dd><%= order.utrSubmissions %> of <%= maxAttempts %></dd></div>
          </dl>
          <% if (order.attempts.length > 0) { %>
          <h3>UTR history</h3>
          <ul class="plain history">
            <% order.attempts.forEach((attempt) => { %><li><span class="mono"><%= attempt.utr %></span> <span class="meta"><%= attempt.at %></span></li><% }) %>
          </ul>
          <% } %>
        </section>
      </div>
      <aside class="detail-side" aria-labelledby="actions-heading">
        <section class="card action-card">
          <h2 id="actions-heading">Actions</h2>
          <% if (!actions.canMarkPaid && !actions.canMarkNotReceived && !actions.canCancel) { %><p class="meta">No actions are available for this order.</p><% } %>
          <div class="action-stack">
            <% if (actions.canMarkPaid) { %><form method="post" action="/orders/<%= order.id %>/paid"><button type="submit" class="button button-block">Mark as paid</button></form><% } %>
            <% if (actions.canMarkNotReceived && lastAttempt) { %><p class="callout" role="note">This was the customer's last allowed attempt (<%= maxAttempts %> of <%= maxAttempts %>). Choosing Payment not received will cancel this order and email the customer.</p>
            <form method="post" action="/orders/<%= order.id %>/not-received" data-confirm="This was attempt <%= maxAttempts %> of <%= maxAttempts %>. Marking it not received will CANCEL this order. Continue?"><button type="submit" class="button button-secondary button-block">Payment not received: cancel order</button></form>
            <% } else if (actions.canMarkNotReceived) { %><form method="post" action="/orders/<%= order.id %>/not-received" data-confirm="Mark this payment as not received? The customer will be able to send a new UTR."><button type="submit" class="button button-secondary button-block">Payment not received</button></form><% } %>
            <a class="button button-secondary button-block" href="<%= whatsappUrl %>" target="_blank" rel="noopener noreferrer">Message customer on WhatsApp<span class="visually-hidden"> (opens in a new tab)</span></a>
          </div>
          <% if (actions.canCancel) { %>
          <details class="danger-zone">
            <summary>Cancel this order</summary>
            <p>Cancelling puts the reserved stock back and cannot be undone.</p>
            <p><a class="button button-danger button-block" href="/orders/<%= order.id %>/cancel">Cancel order</a></p>
          </details>
          <% } %>
        </section>
      </aside>
    </div>
    <script src="/js/confirm-submit.js" defer></script>
<%- include('partials/footer') %>
