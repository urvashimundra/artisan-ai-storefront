<%- include('partials/header') %>
    <h1>Shop settings</h1>
    <% const errors = locals.errors || {}; const values = locals.values || {}; %>
    <% if (locals.notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
    <% if (locals.aiError) { %><p class="alert" role="alert"><%= aiError %></p><% } %>
    <% const translationErrors = locals.translationErrors || {}; %>
    <% if (Object.keys(errors).length > 0) { %>
    <p class="alert" role="alert">Please check the fields marked below.</p>
    <% } %>
    <form method="post" action="/store/settings" class="stack" novalidate>
      <div class="field">
        <label for="tagline">Tagline</label>
        <input type="text" id="tagline" name="tagline" maxlength="120" value="<%= values.tagline || '' %>"
          aria-describedby="tagline-hint<%= errors.tagline ? ' tagline-error' : '' %>"<% if (errors.tagline) { %> aria-invalid="true"<% } %>>
        <p id="tagline-hint" class="hint">One short line under your shop name. Up to 120 characters.</p>
        <% if (errors.tagline) { %><p id="tagline-error" class="error-text"><%= errors.tagline %></p><% } %>
      </div>
      <div class="field">
        <label for="story">Story (<%= defaultLanguageName %>)</label>
        <textarea id="story" name="story" maxlength="2000" lang="<%= defaultLanguage %>" required
          aria-describedby="story-hint<%= errors.story ? ' story-error' : '' %>"<% if (errors.story) { %> aria-invalid="true"<% } %>><%= values.story || '' %></textarea>
        <p id="story-hint" class="hint">Shown on your shop. Changing the tagline or story withdraws your approved translations until you approve them again.</p>
        <% if (errors.story) { %><p id="story-error" class="error-text"><%= errors.story %></p><% } %>
      </div>
      <div class="field">
        <label for="accentKey">Shop colour</label>
        <select id="accentKey" name="accentKey" required
          <% if (errors.accentKey) { %>aria-invalid="true" aria-describedby="accentKey-error"<% } %>>
          <% accents.forEach((accent) => { %>
          <option value="<%= accent.key %>"<%= values.accentKey === accent.key ? ' selected' : '' %>><%= accent.label %></option>
          <% }) %>
        </select>
        <% if (errors.accentKey) { %><p id="accentKey-error" class="error-text"><%= errors.accentKey %></p><% } %>
      </div>
      <div class="field">
        <label for="whatsappNumber">WhatsApp number</label>
        <input type="tel" id="whatsappNumber" name="whatsappNumber" maxlength="30" autocomplete="off" inputmode="tel"
          value="<%= values.whatsappNumber || '' %>"
          aria-describedby="whatsappNumber-hint<%= errors.whatsappNumber ? ' whatsappNumber-error' : '' %>"<% if (errors.whatsappNumber) { %> aria-invalid="true"<% } %>>
        <p id="whatsappNumber-hint" class="hint">For example 98765 43210 or +91 98765 43210. Customers can see this number when they tap the WhatsApp button, so use a number you are happy to share.</p>
        <% if (errors.whatsappNumber) { %><p id="whatsappNumber-error" class="error-text"><%= errors.whatsappNumber %></p><% } %>
      </div>
      <div class="field">
        <label for="whatsappEnabled"><input type="checkbox" id="whatsappEnabled" name="whatsappEnabled" value="on"<%= values.whatsappEnabled ? ' checked' : '' %>> Show the &ldquo;Ask on WhatsApp&rdquo; button on my shop</label>
        <p class="hint">The button stays hidden until you tick this and enter a number.</p>
      </div>
      <div class="field">
        <label for="instagramHandle">Instagram handle</label>
        <input type="text" id="instagramHandle" name="instagramHandle" maxlength="31" autocapitalize="none" spellcheck="false"
          value="<%= values.instagramHandle || '' %>"
          aria-describedby="instagramHandle-hint<%= errors.instagramHandle ? ' instagramHandle-error' : '' %>"<% if (errors.instagramHandle) { %> aria-invalid="true"<% } %>>
        <p id="instagramHandle-hint" class="hint">Optional. For example mati.no.rang (a leading @ is fine).</p>
        <% if (errors.instagramHandle) { %><p id="instagramHandle-error" class="error-text"><%= errors.instagramHandle %></p><% } %>
      </div>
      <div class="field">
        <label for="upiId">UPI ID</label>
        <input type="text" id="upiId" name="upiId" maxlength="100" autocapitalize="none" spellcheck="false" autocomplete="off"
          value="<%= values.upiId || '' %>"
          aria-describedby="upiId-hint<%= errors.upiId ? ' upiId-error' : '' %>"<% if (errors.upiId) { %> aria-invalid="true"<% } %>>
        <p id="upiId-hint" class="hint">Optional. Saved for payment requests later. It is never shown on your shop page.</p>
        <% if (errors.upiId) { %><p id="upiId-error" class="error-text"><%= errors.upiId %></p><% } %>
      </div>
      <div><button type="submit" class="button">Save settings</button> <a href="/dashboard">Back to dashboard</a></div>
      <p><a href="/s/<%= shopSlug %>" target="_blank" rel="noopener noreferrer">View your shop (opens in a new tab)</a></p>
    </form>
    <section class="stack" aria-labelledby="translations-heading">
      <h2 id="translations-heading">Tagline and story in other languages</h2>
      <p class="hint">Your shop name is never translated. Visitors see a translation only after you approve it; until then they see your <%= defaultLanguageName %> text.</p>
      <dl class="details">
        <dt>Tagline (<%= defaultLanguageName %>)</dt>
        <dd lang="<%= defaultLanguage %>"><%= defaultTagline || 'None' %></dd>
        <dt>Story (<%= defaultLanguageName %>)</dt>
        <dd lang="<%= defaultLanguage %>"><%= defaultStory %></dd>
      </dl>
<% if (canDraft) { %>      <form method="post" action="/store/settings/translations/draft" class="stack">
        <p class="hint">Claude reads only your tagline and story, and writes a draft in each other language. It replaces the text below for those languages and unapproves them. You always review before anything is public.</p>
        <div><button type="submit" class="button">Draft translations with Claude</button></div>
      </form>
<% } %><% translationRows.forEach((row) => { %>      <form method="post" action="/store/settings/translations" class="stack" novalidate>
        <h3 id="tr-<%= row.language %>-heading"><%= row.name %></h3>
        <input type="hidden" name="language" value="<%= row.language %>">
<% if (row.source === 'ai' && (row.tagline || row.story)) { %>        <p><strong>AI draft<%= row.approved ? ', approved by you' : ', not yet approved' %></strong></p>
<% } %>        <div class="field">
          <label for="tr-<%= row.language %>-tagline">Tagline (<%= row.name %>)</label>
          <input type="text" id="tr-<%= row.language %>-tagline" name="tagline" maxlength="120" lang="<%= row.language %>" value="<%= row.tagline %>"<% if (translationErrors[row.language]) { %> aria-invalid="true" aria-describedby="tr-<%= row.language %>-error"<% } %>>
        </div>
        <div class="field">
          <label for="tr-<%= row.language %>-story">Story (<%= row.name %>)</label>
          <textarea id="tr-<%= row.language %>-story" name="story" maxlength="2000" lang="<%= row.language %>"<% if (translationErrors[row.language]) { %> aria-invalid="true" aria-describedby="tr-<%= row.language %>-error"<% } %>><%= row.story %></textarea>
        </div>
<% if (translationErrors[row.language]) { %>        <p id="tr-<%= row.language %>-error" class="error-text"><%= translationErrors[row.language] %></p>
<% } %>        <div class="field">
          <label for="tr-<%= row.language %>-approved"><input type="checkbox" id="tr-<%= row.language %>-approved" name="approved" value="on"<%= row.approved ? ' checked' : '' %>> Approve: show this <%= row.name %> text on my shop</label>
        </div>
        <div><button type="submit" class="button">Save <%= row.name %></button></div>
      </form>
<% }) %>    </section>
<%- include('partials/footer') %>
