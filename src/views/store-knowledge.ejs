<%- include('partials/header') %>
    <h1>Shop notes for the assistant</h1>
<% if (onboarding) { %>    <p class="hint">Step 4 of 4. Optional. <a href="/dashboard?welcome=1">Skip, I will do this later</a></p>
<% } %>    <p>Write what customers often ask: delivery, returns, custom orders, bulk discounts and care. When a customer asks you a question on your shop, an AI assistant answers from these notes and from your products. If the answer is not here, it passes the question to you.</p>
    <p class="callout"><strong>Customers can read what you write here through the assistant's answers.</strong> Do not write bank details, passwords or private information.</p>
<% if (notice) { %>    <p class="notice" role="status"><%= notice %></p>
<% } %><% if (aiError) { %>    <p class="alert" role="alert"><%= aiError %></p>
<% } %>
    <section class="stack" aria-labelledby="notes-heading">
      <h2 id="notes-heading">Your notes</h2>
<% if (documentError) { %>      <p class="error-summary" role="alert" id="notes-error"><%= documentError %></p>
<% } %>      <p><a href="/knowledge-template.md" download>Download the notes template (a plain text file with examples)</a></p>
      <form method="post" action="/store/knowledge<%= stepSuffix %>" class="stack">
        <div class="field">
          <label for="knowledge-content">Notes (any language)</label>
          <textarea id="knowledge-content" name="content" rows="14" maxlength="<%= maxLength %>" data-counter="knowledge-count" aria-describedby="knowledge-hint knowledge-count<%= documentError ? ' notes-error' : '' %>"<%= documentError ? ' aria-invalid="true"' : '' %>><%= content %></textarea>
          <p id="knowledge-hint" class="hint">Up to <%= maxLength %> characters. Saving new notes clears your confirmed bulk discounts, so you can check them again.</p>
          <p id="knowledge-count" class="hint" aria-live="polite"></p>
        </div>
        <div class="field" data-knowledge-file hidden>
          <label for="knowledge-file">Or choose a .txt or .md file</label>
          <input type="file" id="knowledge-file" accept=".txt,.md,.markdown,text/plain,text/markdown" aria-describedby="knowledge-file-status">
          <p id="knowledge-file-status" class="hint" role="status" aria-live="polite"></p>
        </div>
        <div><button type="submit" class="button">Save notes</button></div>
      </form>
    </section>
    <section class="stack" aria-labelledby="bulk-heading">
      <h2 id="bulk-heading">Bulk discounts</h2>
      <p>The assistant only uses the discounts you confirm here. It never makes up a discount. Leave a row empty if you do not need it.</p>
<% if (confirmedRules.length > 0) { %>      <p class="hint">Confirmed now: <%= confirmedRules.map((tier) => tier.minQty + ' or more: ' + tier.percentOff + '% off').join('; ') %>.</p>
<% } else { %>      <p class="hint">No bulk discount is confirmed yet.</p>
<% } %><% if (rulesError) { %>      <p class="error-summary" role="alert" id="rules-error"><%= rulesError %></p>
<% } %>      <form method="post" action="/store/knowledge/rules<%= stepSuffix %>" class="stack">
        <ol class="plain stack" aria-label="Bulk discount rows">
<% ruleRows.forEach((row) => { %>          <li class="field-row">
            <div class="field">
              <label for="minQty<%= row %>">Row <%= row %>: items (minimum)</label>
              <input type="text" id="minQty<%= row %>" name="minQty<%= row %>" inputmode="numeric" pattern="[0-9]*" autocomplete="off" maxlength="4" value="<%= ruleValues['minQty' + row] || '' %>"<%= rulesError ? ' aria-describedby="rules-error"' : '' %>>
            </div>
            <div class="field">
              <label for="percentOff<%= row %>">Row <%= row %>: percent off</label>
              <input type="text" id="percentOff<%= row %>" name="percentOff<%= row %>" inputmode="numeric" pattern="[0-9]*" autocomplete="off" maxlength="2" value="<%= ruleValues['percentOff' + row] || '' %>"<%= rulesError ? ' aria-describedby="rules-error"' : '' %>>
            </div>
          </li>
<% }) %>        </ol>
        <p class="hint">Example: 10 items, 5 percent. Items go up from row to row, from 2 to 1000. Percent is from 1 to 50.</p>
        <div><button type="submit" class="button">Save bulk discounts</button></div>
      </form>
<% if (canExtract) { %>      <form method="post" action="/store/knowledge/rules/find<%= stepSuffix %>" class="stack">
        <p class="hint">Claude can read your saved notes and suggest the discounts. It only fills the boxes above. Check them, then save.</p>
        <div><button type="submit" class="button button-secondary"<%= hasDocument ? '' : ' disabled' %>>Find bulk discounts with Claude</button></div>
<% if (!hasDocument) { %>        <p class="hint">Save your notes first.</p>
<% } %>      </form>
<% } %>    </section>
    <p><a href="/dashboard">Back to dashboard</a></p>
    <script src="/js/char-counter.js" defer></script>
    <script src="/js/knowledge-file.js" defer></script>
<%- include('partials/footer') %>
