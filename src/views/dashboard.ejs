<%- include('partials/header') %>
    <h1>Your store</h1>
    <% if (locals.welcome) { %><p class="notice" role="status">Your shop is ready. <a href="/s/<%= store.slug %>" target="_blank" rel="noopener noreferrer">View your shop (opens in a new tab)</a></p><% } %>
    <% if (!progress.complete) { %>
    <section class="stack card" aria-labelledby="progress-heading">
      <h2 id="progress-heading">Finish setting up</h2>
      <ul class="checklist">
        <% progress.steps.forEach((step) => { %>
        <li><%= step.label %>: <strong><%= step.done ? 'Done' : 'To do' %></strong><% if (step.href) { %> <a href="<%= step.href %>"><%= step.done ? 'Review' : 'Continue' %><span class="visually-hidden">: <%= step.label %></span></a><% } %></li>
        <% }) %>
      </ul>
    </section>
    <% } %>
    <dl class="details card">
      <dt>Store name</dt>
      <dd><%= store.name %></dd>
      <dt>Store address</dt>
      <dd>/s/<%= store.slug %></dd>
      <dt>Default language</dt>
      <dd><%= languageName %></dd>
      <dt>Story</dt>
      <dd lang="<%= store.defaultLanguage %>"><%= store.story %></dd>
    </dl>
    <div class="actions">
      <a class="button" href="/s/<%= store.slug %>" target="_blank" rel="noopener noreferrer">View your shop</a>
      <button type="button" class="button button-secondary" data-share data-share-url="<%= shopUrl %>" data-share-title="<%= store.name %>" data-copied="Link copied" hidden>Copy shop link</button>
      <a class="button button-secondary" href="/store/settings">Shop settings</a>
      <% if (locals.productsEnabled) { %><a class="button button-secondary" href="/products">Manage products</a><% } %>
      <% if (locals.enquiriesEnabled) { %><a class="button button-secondary" href="/enquiries">Conversations<% if (locals.needsYouEnquiries) { %> <span class="badge"><%= needsYouEnquiries %> need you</span><% } %></a><% } %>
      <% if (locals.knowledgeEnabled) { %><a class="button button-secondary" href="/store/knowledge">Shop notes</a><% } %>
      <% if (locals.ordersEnabled) { %><a class="button button-secondary" href="/orders">Orders<% if (locals.pendingPayments) { %> <span class="badge"><%= pendingPayments %> to check</span><% } %></a><% } %>
    </div>
    <p class="hint" role="status" aria-live="polite" data-share-status></p>
    <script src="/js/share.js" defer></script>
<%- include('partials/footer') %>
