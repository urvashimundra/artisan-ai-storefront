<%- include('partials/header') %>
    <h1>Create your store</h1>
    <p class="hint"><strong>Step 1 of 4.</strong> Your shop name, address and story.</p>
    <% const errors = locals.errors || {}; const values = locals.values || {}; %>
    <% if (Object.keys(errors).length > 0) { %>
    <p class="alert" role="alert">Please check the fields marked below.</p>
    <% } %>
    <div class="card onboard-card">
    <form method="post" action="/store/new" class="stack" novalidate>
      <div class="field">
        <label for="name">Store name</label>
        <input type="text" id="name" name="name" required maxlength="80" value="<%= values.name || '' %>"
          <% if (errors.name) { %>aria-invalid="true" aria-describedby="name-error"<% } %>>
        <% if (errors.name) { %><p id="name-error" class="error-text"><%= errors.name %></p><% } %>
      </div>
      <div class="field">
        <label for="slug">Website address</label>
        <div class="input-prefix">
          <span class="input-prefix-text" aria-hidden="true"><%= baseHost %>/s/</span>
          <input type="text" id="slug" name="slug" required maxlength="40" autocapitalize="none" spellcheck="false"
            value="<%= values.slug || '' %>"
            aria-describedby="slug-hint slug-example<%= errors.slug ? ' slug-error' : '' %>"<% if (errors.slug) { %> aria-invalid="true"<% } %>>
        </div>
        <p id="slug-hint" class="hint">This is your shop's web address on this site, not a physical location. Use lowercase letters, numbers and hyphens.</p>
        <p id="slug-example" class="hint"><%= baseHost %>/s/<%= values.slug || 'your-address' %></p>
        <% if (errors.slug) { %><p id="slug-error" class="error-text"><%= errors.slug %></p><% } %>
      </div>
      <div class="field">
        <label for="defaultLanguage">Default language</label>
        <select id="defaultLanguage" name="defaultLanguage" required
          <% if (errors.defaultLanguage) { %>aria-invalid="true" aria-describedby="defaultLanguage-error"<% } %>>
          <option value="en"<%= values.defaultLanguage === 'en' ? ' selected' : '' %>>English</option>
          <option value="gu"<%= values.defaultLanguage === 'gu' ? ' selected' : '' %>>Gujarati</option>
          <option value="hi"<%= values.defaultLanguage === 'hi' ? ' selected' : '' %>>Hindi</option>
        </select>
        <% if (errors.defaultLanguage) { %><p id="defaultLanguage-error" class="error-text"><%= errors.defaultLanguage %></p><% } %>
      </div>
      <div class="field">
        <label for="story">Your story</label>
        <textarea id="story" name="story" required maxlength="2000"
          <% if (errors.story) { %>aria-invalid="true" aria-describedby="story-error"<% } %>><%= values.story || '' %></textarea>
        <% if (errors.story) { %><p id="story-error" class="error-text"><%= errors.story %></p><% } %>
      </div>
      <div class="field">
        <label for="tagline">Tagline (optional)</label>
        <input type="text" id="tagline" name="tagline" maxlength="120" value="<%= values.tagline || '' %>"
          aria-describedby="tagline-hint<%= errors.tagline ? ' tagline-error' : '' %>"<% if (errors.tagline) { %> aria-invalid="true"<% } %>>
        <p id="tagline-hint" class="hint">One short line under your shop name. Up to 120 characters.</p>
        <% if (errors.tagline) { %><p id="tagline-error" class="error-text"><%= errors.tagline %></p><% } %>
      </div>
      <div class="field">
        <label for="accentKey">Shop colour</label>
        <div class="select-swatch">
          <span class="swatch" aria-hidden="true"></span>
          <select id="accentKey" name="accentKey"
            <% if (errors.accentKey) { %>aria-invalid="true" aria-describedby="accentKey-error"<% } %>>
            <% accents.forEach((accent) => { %>
            <option value="<%= accent.key %>"<%= values.accentKey === accent.key ? ' selected' : '' %>><%= accent.label %></option>
            <% }) %>
          </select>
        </div>
        <% if (errors.accentKey) { %><p id="accentKey-error" class="error-text"><%= errors.accentKey %></p><% } %>
      </div>
      <div class="actions"><button type="submit" class="button">Create store</button></div>
    </form>
    </div>
<%- include('partials/footer') %>
