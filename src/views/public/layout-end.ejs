  </main>
<% if (locals.kind !== 'chat') { %>  <footer class="site-footer">
    <p><%= strings.footer %></p>
  </footer>
<% } %><% if (['shop', 'product', 'enquiry', 'chat'].includes(locals.kind)) { %>  <script src="/js/share.js" defer></script>
<% } %><% if (locals.kind === 'chat') { %>  <script src="/js/chat.js" defer></script>
<% } %><% if (locals.kind === 'chat-start') { %>  <script src="/js/char-counter.js" defer></script>
<% } %><% if (locals.ask) { %>  <script src="/js/char-counter.js" defer></script>
<% } %><% if (locals.autosubmit) { %>  <script src="/js/autosubmit.js" defer></script>
<% } %><% if (locals.kind === 'order') { %>  <script src="/js/copy-upi.js" defer></script>
  <script src="/js/countdown.js" defer></script>
<% } %></body>
</html>
