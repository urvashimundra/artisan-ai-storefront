    <nav class="lang-nav" aria-label="<%= strings.language %>">
      <ul class="lang-list">
<% languageLinks.forEach((link) => { %>        <li><a href="<%= link.href %>" lang="<%= link.lang %>" hreflang="<%= link.lang %>"<% if (link.current) { %> aria-current="true"<% } %>><%= link.name %></a></li>
<% }) %>      </ul>
    </nav>
