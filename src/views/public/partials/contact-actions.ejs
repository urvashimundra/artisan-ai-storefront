    <div class="contact-actions" role="group" aria-label="<%= strings.contactHeading %>">
<% if (locals.chatHref) { %>      <a class="button button-primary" href="<%= chatHref %>" target="_blank" rel="noopener noreferrer" data-contact="chat"><%= strings.chatAskAi %><span class="visually-hidden"> <%= strings.chatOpensNewTab %></span></a>
<% } %><% if (whatsappUrl) { %>      <a class="button button-secondary" href="<%= whatsappUrl %>" target="_blank" rel="noopener noreferrer" data-contact="whatsapp"><%= strings.askOnWhatsApp %><span class="visually-hidden"> <%= strings.chatOpensNewTab %></span></a>
<% } %><% if (instagramUrl) { %>      <a class="button button-secondary" href="<%= instagramUrl %>" target="_blank" rel="noopener noreferrer" data-contact="instagram"><%= strings.instagram %><span class="visually-hidden"> <%= strings.chatOpensNewTab %></span></a>
<% } %>      <button type="button" class="button button-secondary" data-contact="share" data-share data-share-title="<%= shop.name %>" data-copied="<%= strings.linkCopied %>" hidden><%= strings.share %></button>
    </div>
    <p class="share-status" role="status" aria-live="polite" data-share-status></p>
