<%- include('layout') %>
    <div class="chat" data-chat data-poll-url="<%= paths.poll %>" data-poll-ms="<%= pollMs %>" data-last-seq="<%= lastSeq %>" data-running="<%= conversation.aiRunning ? 'true' : 'false' %>" data-lang="<%= language %>"
         data-str-sending="<%= strings.chatSending %>" data-str-network="<%= strings.chatErrNetwork %>" data-str-retry="<%= strings.chatRetry %>" data-str-unknown="<%= strings.chatErrUnknown %>" data-str-sources="<%= strings.chatSourcesLabel %>">
      <header class="chat-head">
        <span class="chat-avatar" aria-hidden="true"><%= Array.from(shop.name)[0] %></span>
        <div class="chat-title">
          <h1 lang="<%= shop.lang %>"><%= shop.name %></h1>
          <p class="chat-status"><span class="status-dot status-<%= conversation.status %>" aria-hidden="true"></span><span data-chat-status><%= conversation.statusLabel %></span></p>
        </div>
        <a class="chat-back" href="<%= shopHref %>"><%= strings.chatBackToShop %></a>
      </header>
      <div class="chat-notes">
        <p class="chat-ai-note"><%= strings.chatAiLabel %></p>
<% if (reviewPending) { %>        <p class="review-note" role="note" data-translation-status="pending-review"><%= strings.chatReviewNotice %></p>
<% } %>      </div>
      <details class="chat-link">
        <summary><%= strings.chatSaveLinkHeading %></summary>
        <p class="hint"><%= strings.chatSaveLinkNote %></p>
        <label class="visually-hidden" for="chat-link-url"><%= strings.chatSaveLinkHeading %></label>
        <input type="text" id="chat-link-url" readonly value="<%= conversation.link %>">
        <button type="button" class="button button-secondary" data-share data-share-url="<%= conversation.link %>" data-share-title="<%= shop.name %>" data-copied="<%= strings.linkCopied %>" hidden><%= strings.chatCopyLink %></button>
        <p class="share-status" role="status" aria-live="polite" data-share-status></p>
      </details>
      <div class="chat-log" id="chat-log" role="log" aria-live="polite" aria-relevant="additions" aria-label="<%= strings.chatLogLabel %>" tabindex="0">
        <ol class="chat-messages" id="chat-messages">
<% messages.forEach((m) => { %>          <li class="msg msg-<%= m.role %><%= m.escalated ? ' msg-flag' : '' %>" data-seq="<%= m.seq %>" data-role="<%= m.role %>">
            <div class="msg-bubble">
<% if (m.role !== 'customer') { %>              <p class="msg-speaker"><%= m.speaker %></p>
<% } else { %>              <p class="visually-hidden"><%= m.speaker %></p>
<% } %>              <p class="msg-text"><%= m.text %></p>
<% if (m.sources.length > 0) { %>              <p class="msg-sources"><%= strings.chatSourcesLabel %>: <%= m.sources.join(', ') %></p>
<% } %>              <p class="msg-meta"><time datetime="<%= m.time %>"><%= m.timeLabel %></time></p>
            </div>
          </li>
<% }) %>        </ol>
        <p class="chat-typing" id="chat-typing" role="status"<% if (!conversation.aiRunning) { %> hidden<% } %>><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span> <%= strings.chatThinking %></p>
      </div>
      <div class="chat-seller" data-needs-seller<% if (!conversation.needsSeller) { %> hidden<% } %>>
        <p><%= strings.chatSellerWaiting %></p>
<% if (whatsappUrl) { %>        <p><a class="button button-secondary" href="<%= whatsappUrl %>" target="_blank" rel="noopener noreferrer"><%= strings.chatWhatsappSeller %> <span class="visually-hidden"><%= strings.chatOpensNewTab %></span></a></p>
<% } %>      </div>
      <p class="chat-error" id="chat-error" role="alert"<% if (!locals.composerError) { %> hidden<% } %>><%= locals.composerError || '' %></p>
      <form class="composer" id="composer" method="post" action="<%= composer.action %>">
        <input type="hidden" name="messageId" value="<%= locals.composerMessageId || composer.messageId %>">
        <label class="visually-hidden" for="composer-text"><%= strings.chatComposerLabel %></label>
        <textarea id="composer-text" name="message" rows="1" maxlength="<%= composer.maxMessage %>" required enterkeyhint="send" placeholder="<%= strings.chatComposerLabel %>"><%= locals.composerValue || '' %></textarea>
        <button type="submit" class="composer-send"><span class="composer-send-label"><%= strings.chatSend %></span></button>
      </form>
    </div>
<%- include('layout-end') %>
