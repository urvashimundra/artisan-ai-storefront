<%- include('partials/header') %>
    <h1>Log in</h1>
    <% if (locals.notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
    <% if (locals.error) { %><p id="login-error" class="alert error-text" role="alert"><%= error %></p><% } %>
    <form method="post" action="/login" class="stack" novalidate>
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="username" required maxlength="254"
          <% if (locals.error) { %>aria-invalid="true" aria-describedby="login-error"<% } %>>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required
          <% if (locals.error) { %>aria-invalid="true" aria-describedby="login-error"<% } %>>
      </div>
      <div><button type="submit" class="button">Log in</button></div>
    </form>
<%- include('partials/footer') %>
