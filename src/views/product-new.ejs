<%- include('partials/header') %>
    <h1>Add a product</h1>
    <p>Choose a photo and tell us about it. The AI will suggest a title and description in English, Gujarati and Hindi. You review and approve everything before it is published.</p>
    <noscript><p class="alert">This page needs JavaScript to prepare your photo. Please turn it on and reload.</p></noscript>
    <form id="new-product-form" class="stack" novalidate data-upload-url="/products/image">
      <div class="field">
        <label for="photo">Product photo</label>
        <input type="file" id="photo" name="photo" accept="image/jpeg,image/png,image/webp" required aria-describedby="photo-hint photo-error">
        <p id="photo-hint" class="hint">JPEG, PNG or WebP. Large photos are made smaller on your device first, and location data is removed.</p>
        <p id="photo-error" class="error-text" hidden></p>
      </div>
      <div class="field">
        <label for="story">Your story about this product</label>
        <textarea id="story" name="story" required maxlength="1500" aria-describedby="story-hint story-error"></textarea>
        <p id="story-hint" class="hint">Materials, how it is made, who it is for. Up to 1500 characters. Only write facts you want shown.</p>
        <p id="story-error" class="error-text" hidden></p>
      </div>
      <div><button type="submit" class="button" id="submit-button">Upload and write listing</button></div>
      <p id="progress" class="notice" role="status" aria-live="polite" hidden></p>
      <p id="form-error" class="alert" role="alert" hidden></p>
    </form>
    <script src="/js/resize.js" defer></script>
    <script src="/js/product-upload.js" defer></script>
<%- include('partials/footer') %>
