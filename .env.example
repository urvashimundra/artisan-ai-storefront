# Copy to .env for local development. Never commit .env. Placeholders only.
# On GoDaddy, set each variable as a secret/variable per variant (preview AND publish).

# Required to boot
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Optional: reverse-proxy hops to trust for client IP (integer, default 1)
TRUST_PROXY=1

# Optional: enables GET /internal/diagnostics (min 24 chars). Leave unset to disable the route.
DIAGNOSTICS_TOKEN=

# Supabase (REQUIRED from Module 1; server-side only, the service-role key bypasses RLS)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Owner signup (Module 1). Optional: if unset, /signup does not exist (404). Min 16 chars. Never share or commit.
SIGNUP_INVITE_CODE=

# Optional: extra trusted origins for the Origin check, comma-separated, each a bare origin (scheme + host [+ port],
# no path, query or fragment), e.g. https://theartisanstory.in. BASE_URL's origin is always trusted.
# Cookie name and Secure flag derive from BASE_URL (https => __Host-session + Secure), not from NODE_ENV.
ALLOWED_ORIGINS=

# Demo owner. Read ONLY by scripts/seed-demo.js on the developer machine (node --env-file=.env scripts/seed-demo.js).
# Not required to boot the app. Password policy is the same as signup (12 to 128 characters).
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=

# AI group (ANTHROPIC_API_KEY and AI_DAILY_BUDGET_USD required once any is set)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
AI_DAILY_BUDGET_USD=

# SMTP group (all required once any is set). Titan: smtpout.secureserver.net, full address as user.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
OWNER_NOTIFY_EMAIL=
