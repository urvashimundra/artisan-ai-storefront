# Copy to .env for local development. Never commit .env. Placeholders only.
# On GoDaddy, set each variable as a secret/variable per variant (preview AND publish).

# Required to boot
# NODE_ENV: development | test | production. Any other value is accepted and treated as production (logger level only).
NODE_ENV=development
PORT=3000
# BASE_URL must be https://..., except http://localhost or http://127.0.0.1 for local development.
BASE_URL=http://localhost:3000

# Optional: reverse-proxy hops to trust for client IP (integer, default 1)
TRUST_PROXY=1

# Optional: enables GET /internal/diagnostics (min 24 chars). Leave unset to disable the route.
DIAGNOSTICS_TOKEN=

# GoDaddy hosting mail relay. Every email (order emails, seller alerts, contact form) is sent through it by the outbox worker,
# and it is used by the opt-in relay-send diagnostics check (?checks=relay-send).
# Must be a bare http://localhost or http://127.0.0.1 origin (no path). Default shown. The test email goes to
# OWNER_NOTIFY_EMAIL. The relay exists only in the hosted runtime (Publish), not on a laptop.
EMAIL_RELAY_URL=http://127.0.0.1:2525

# Email outbox (Module 5). Every email is stored first and sent by a background worker through the relay above.
# CONTACT_INBOX_EMAIL: where the main-site contact form (/contact) is delivered. If unset, OWNER_NOTIFY_EMAIL is used;
# if neither is set the form still saves messages but sends no email. EMAIL_WORKER_ENABLED: true (default) or false.
CONTACT_INBOX_EMAIL=
EMAIL_WORKER_ENABLED=true
# ORDER_LINK_KEY: 32 random bytes as base64url (43 characters), used to put the customer's private order link in every order email.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))". Keep it ONLY in the host environment;
# losing or changing it makes older emails fall back to the shop link. If unset, order emails carry no private link.
ORDER_LINK_KEY=

# Supabase (REQUIRED from Module 1; server-side only, the service-role key bypasses RLS). SUPABASE_URL must be https://.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Owner signup (Module 1). Optional: if unset, /signup does not exist (404). Min 16 chars. Never share or commit.
SIGNUP_INVITE_CODE=

# Optional: extra trusted origins for the Origin check, comma-separated, each a bare origin (scheme + host [+ port],
# no path, query or fragment), e.g. https://theartisanstory.in. BASE_URL's origin is always trusted.
# Cookie name and Secure flag derive from BASE_URL (https => __Host-session + Secure), not from NODE_ENV.
ALLOWED_ORIGINS=

# Demo owner. Read ONLY by scripts/seed-demo.js on the developer machine (node --env-file=.env scripts/seed-demo.js).
# Not required to boot the app. Password policy is the same as signup (12 to 128 characters).
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=

# AI group (ANTHROPIC_API_KEY required once any is set)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# AI budget (all optional; decimal USD, max 6 decimals; defaults shown). Per normal owner per day, per demo owner per
# day, and all owners combined per day (India date). Unset or blank uses the default.
AI_DAILY_BUDGET_USD=1.00
AI_DEMO_DAILY_BUDGET_USD=0.50
AI_GLOBAL_DAILY_BUDGET_USD=5.00

# Owner address used as the relay-send diagnostics test recipient and as the fallback for the contact form when
# CONTACT_INBOX_EMAIL is unset. Optional.
OWNER_NOTIFY_EMAIL=
